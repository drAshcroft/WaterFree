{
  "name": "waterfree",
  "displayName": "WaterFree",
  "description": "You architect. AI executes. Structured AI pair programming where you lead like a waterfall — free from the bottlenecks.",
  "version": "0.1.0",
  "repository":"https://github.com/drAshcroft/WaterFree",
  "publisher": "waterfree",
  "license": "AGPL-3.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "waterfree",
          "title": "WaterFree",
          "icon": "$(hubot)"
        }
      ]
    },
    "views": {
      "waterfree": [
        {
          "id": "waterfree.planSidebar",
          "name": "Wizards",
          "type": "webview",
          "when": "true"
        },
        {
          "id": "waterfree.quickActions",
          "name": "Quick Actions",
          "when": "true"
        }
      ]
    },
    "commands": [
      {
        "command": "waterfree.start",
        "title": "WaterFree: Start Session"
      },
      {
        "command": "waterfree.setup",
        "title": "WaterFree: Setup"
      },
      {
        "command": "waterfree.indexWorkspace",
        "title": "WaterFree: Check/Index Workspace",
        "icon": {
          "light": "resources/index-light.svg",
          "dark": "resources/index-dark.svg"
        }
      },
      {
        "command": "waterfree.openSettings",
        "title": "WaterFree: Settings",
        "icon": "$(gear)"
      },
      {
        "command": "waterfree.delegateToAcpSubagent",
        "title": "WaterFree: Delegate to ACP Subagent"
      },
      {
        "command": "waterfree.generateAnnotation",
        "title": "WaterFree: Generate Annotation"
      },
      {
        "command": "waterfree.approveAnnotation",
        "title": "✓ Approve"
      },
      {
        "command": "waterfree.alterAnnotation",
        "title": "✎ Alter"
      },
      {
        "command": "waterfree.redirectTask",
        "title": "⟳ Redirect"
      },
      {
        "command": "waterfree.skipTask",
        "title": "Skip Task"
      },
      {
        "command": "waterfree.livePairDebug",
        "title": "Live Debug"
      },
      {
        "command": "waterfree.pushDebugToAgent",
        "title": "WaterFree: Push Debug Snapshot to Agent"
      },
      {
        "command": "waterfree.quickAction",
        "title": "Run Quick Action"
      },
      {
        "command": "waterfree.buildKnowledge",
        "title": "WaterFree Snippetize: Snippetize Workspace",
        "icon": "$(brain)"
      },
      {
        "command": "waterfree.addKnowledgeRepo",
        "title": "WaterFree Snippetize: Snippetize Repo (Git URL or Path)"
      },
      {
        "command": "waterfree.openTodoBoard",
        "title": "WaterFree: Open Todo Board",
        "icon": "$(list-tree)"
      },
      {
        "command": "waterfree.openKnowledge",
        "title": "WaterFree: Open Knowledge Explorer",
        "icon": "$(book)"
      },
      {
        "command": "waterfree.extractProcedure",
        "title": "WaterFree Snippetize: Snippetize Procedure",
        "icon": "$(symbol-method)"
      },
      {
        "command": "waterfree.openWizard",
        "title": "WaterFree: Open Wizard",
        "icon": "$(notebook)"
      },
      {
        "command": "waterfree.runWizardStep",
        "title": "WaterFree: Run Wizard Stage",
        "icon": "$(play)"
      },
      {
        "command": "waterfree.acceptWizardChunk",
        "title": "WaterFree: Accept Wizard Chunk",
        "icon": "$(check)"
      },
      {
        "command": "waterfree.reviseWizardChunk",
        "title": "WaterFree: Revise Wizard Chunk",
        "icon": "$(edit)"
      },
      {
        "command": "waterfree.acceptWizardStep",
        "title": "WaterFree: Accept Wizard Stage",
        "icon": "$(pass)"
      },
      {
        "command": "waterfree.promoteWizardTodos",
        "title": "WaterFree: Promote Wizard Todos",
        "icon": "$(list-selection)"
      },
      {
        "command": "waterfree.startWizardCoding",
        "title": "WaterFree: Start Wizard Coding",
        "icon": "$(run)"
      },
      {
        "command": "waterfree.runWizardReview",
        "title": "WaterFree: Run Wizard Review",
        "icon": "$(search)"
      },
      {
        "command": "waterfree.refineWizardIdea",
        "title": "WaterFree: Refine Wizard Idea",
        "icon": "$(lightbulb)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "waterfree.livePairDebug",
          "group": "waterfree@1",
          "when": "inDebugMode"
        },
        {
          "command": "waterfree.extractProcedure",
          "group": "waterfree@2"
        }
      ],
      "view/title": [
        {
          "command": "waterfree.openSettings",
          "when": "view == waterfree.planSidebar",
          "group": "navigation@1"
        }
      ],
      "editor/title": [
        {
          "command": "waterfree.runWizardStep",
          "when": "waterfree.wizardDocActive",
          "group": "navigation@1"
        },
        {
          "command": "waterfree.acceptWizardStep",
          "when": "waterfree.wizardDocActive",
          "group": "navigation@2"
        },
        {
          "command": "waterfree.promoteWizardTodos",
          "when": "waterfree.wizardDocActive",
          "group": "navigation@3"
        },
        {
          "command": "waterfree.startWizardCoding",
          "when": "waterfree.wizardDocActive",
          "group": "navigation@4"
        },
        {
          "command": "waterfree.runWizardReview",
          "when": "waterfree.wizardDocActive",
          "group": "navigation@5"
        }
      ]
    },
    "keybindings": [
      {
        "command": "waterfree.approveAnnotation",
        "key": "ctrl+alt+a",
        "when": "waterfree.awaitingReview"
      },
      {
        "command": "waterfree.alterAnnotation",
        "key": "ctrl+alt+e",
        "when": "waterfree.awaitingReview"
      },
      {
        "command": "waterfree.redirectTask",
        "key": "ctrl+alt+r",
        "when": "waterfree.awaitingReview"
      }
    ],
    "configuration": {
      "title": "WaterFree",
      "properties": {
        "waterfree.anthropicApiKey": {
          "type": "string",
          "default": "",
          "description": "Deprecated plaintext fallback. WaterFree now stores the Anthropic API key in secure secret storage and only uses this setting for one-time migration.",
          "deprecationMessage": "Use the 'WaterFree: Setup' command instead. WaterFree stores API keys in secure secret storage."
        },
        "waterfree.planningModel": {
          "type": "string",
          "default": "claude-opus-4-6",
          "description": "Model used for planning (higher capability)."
        },
        "waterfree.executionModel": {
          "type": "string",
          "default": "claude-sonnet-4-6",
          "description": "Model used for annotation and code execution."
        },
        "waterfree.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Path to Python executable. Must be Python 3.10+."
        },
        "waterfree.rippleDepth": {
          "type": "number",
          "default": 3,
          "description": "How many dependency hops to scan for side effects after each edit."
        },
        "waterfree.graphBinaryPath": {
          "type": "string",
          "default": "codebase-memory-mcp",
          "description": "Path to the codebase-memory-mcp binary. Defaults to 'codebase-memory-mcp' (must be on PATH)."
        },
        "waterfree.godotPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the Godot executable used to run Godot tests (GUT / gdUnit4). Leave blank to fall back to the WATERFREE_GODOT, GODOT_BIN or GODOT environment variables, then 'godot' on PATH. Godot ships many differently named builds, so WaterFree never guesses — point this at the exact binary you want, e.g. C:\\\\Godot\\\\godot.windows.editor.x86_64.exe."
        },
        "waterfree.wizardCodingExecutor": {
          "type": "string",
          "enum": ["acp", "provider", "ask"],
          "enumDescriptions": [
            "Send the wizard's accepted coding tasks to a configured ACP agent, which edits the workspace directly.",
            "Leave the tasks pending in the session for the internal runtime.",
            "Ask each time the coding stage starts."
          ],
          "default": "acp",
          "markdownDescription": "Who builds the code once the `Coding Agents` stage is accepted. Defaults to `acp`: the earlier wizard stages exist to produce prompts a coding agent can execute, and an ACP agent brings its own editing tools. Falls back to queueing the tasks when no agent is configured under `waterfree.acpAgents`."
        },
        "waterfree.acpAllowTerminal": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Let ACP subagents run shell commands through WaterFree, so an agent can run the tests it just wrote. Each command still requires explicit approval and runs inside the workspace, but this is a larger grant than file editing — leave it off unless you want it. When off, WaterFree advertises no terminal support and agents degrade to file edits."
        },
        "waterfree.acpAgents": {
          "type": "array",
          "default": [],
          "markdownDescription": "External agents WaterFree can drive over the [Agent Client Protocol](https://agentclientprotocol.com). Entries merge over the built-ins (`hermes`); reusing a built-in `id` patches it, so you can override just `model` without restating `command`.",
          "items": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "type": "string", "description": "Stable id, e.g. \"hermes\"." },
              "label": { "type": "string", "description": "Display name." },
              "command": { "type": "string", "description": "Executable that speaks ACP over stdio." },
              "args": { "type": "array", "items": { "type": "string" }, "description": "Arguments placing the agent in ACP mode, e.g. [\"acp\"]." },
              "env": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Extra environment variables for the agent process." },
              "model": { "type": "string", "description": "Agent-specific model id pinned per session, e.g. \"openrouter:anthropic/claude-sonnet-4.5\"." },
              "enabled": { "type": "boolean", "default": true }
            }
          }
        },
        "waterfree.publicDocsPath": {
          "type": "string",
          "default": "docs",
          "description": "Workspace-relative or absolute folder where public wizard documents should be written."
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.config.js",
    "watch": "node esbuild.config.js --watch",
    "test:acp": "node scripts/acp-smoke/run.js",
    "test:sidebar": "python scripts/sidebar-layout/check.py",
    "vscode:prepublish": "node esbuild.config.js --minify",
    "package": "node esbuild.config.js --minify && npx @vscode/vsce package --no-dependencies --out waterfree.vsix --baseContentUrl https://localhost"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  }
}
